FROM python:3.11-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY requirements.txt .
RUN --mount=type=cache,id=dynamic-pricing-pip-cache,target=/root/.cache/pip \
    python -m pip install --upgrade --retries 20 --timeout 120 "pip>=25.1,<27" && \
    python -m pip install --retries 20 --resume-retries 20 --timeout 120 -r requirements.txt

# Copy source code
COPY src/ src/
COPY config.yaml .

# Create data & model dirs
RUN mkdir -p data/raw data/processed data/external models

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:8000/health').raise_for_status()" || exit 1

# Run API
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
